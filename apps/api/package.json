{
  "name": "@bella/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@bella/contracts": "workspace:*",
    "@bella/db": "workspace:*",
    "@bella/domain": "workspace:*",
    "@better-auth/drizzle-adapter": "1.7.3",
    "@fastify/cors": "11.3.0",
    "@fastify/sensible": "6.0.5",
    "@node-rs/argon2": "2.2.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "auth": "1.7.3",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
