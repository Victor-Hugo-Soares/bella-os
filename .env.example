# Copie para .env (nunca versionar o .env). Valores abaixo são de desenvolvimento local.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres local (pnpm db:up) — porta 5433 para não colidir com instalações locais.
# DATABASE_URL é o DONO do banco: roda migrations, seed e cria/altera o papel bella_app.
# Nunca é o que a API usa para servir requisições depois do M1.
DATABASE_URL=postgres://bella:bella@localhost:5433/bella_dev
TEST_DATABASE_URL=postgres://bella:bella@localhost:5433/bella_test

# APP_DB_PASSWORD: senha do papel restrito `bella_app` (sem BYPASSRLS, criado pela
# migration 0001). Rode `pnpm --filter @bella/db app-role` após migrar para aplicá-la.
# APP_DATABASE_URL / TEST_APP_DATABASE_URL: como a API/os testes de isolamento se
# conectam de fato — sujeitos a Row Level Security. Valor de exemplo local abaixo;
# em produção a senha vem de um passo de operação separado (ver docs/RUNBOOK_DEV.md).
APP_DB_PASSWORD=bella_app_dev_password
APP_DATABASE_URL=postgres://bella_app:bella_app_dev_password@localhost:5433/bella_dev
TEST_APP_DATABASE_URL=postgres://bella_app:bella_app_dev_password@localhost:5433/bella_test
