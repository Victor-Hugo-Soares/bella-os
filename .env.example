# Copie para .env (nunca versionar o .env). Valores abaixo são de desenvolvimento local.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres local (pnpm db:up) — porta 5433 para não colidir com instalações locais.
# DATABASE_URL é o DONO do banco: roda migrations, seed e cria/altera o papel bella_app.
# NUNCA é o que a API usa para servir requisições a partir do M2 (ver APP_DATABASE_URL) —
# index.ts cai para DATABASE_URL só como conveniência de dev, com aviso alto no log.
DATABASE_URL=postgres://bella:bella@localhost:5433/bella_dev
TEST_DATABASE_URL=postgres://bella:bella@localhost:5433/bella_test

# APP_DB_PASSWORD: senha do papel restrito `bella_app` (sem BYPASSRLS, criado pela
# migration 0000). Rode `pnpm --filter @bella/db app-role` após migrar para aplicá-la.
# APP_DATABASE_URL / TEST_APP_DATABASE_URL: como a API roda de verdade (pnpm dev,
# pnpm start) e como os testes de integração conectam — sujeitos a Row Level Security.
# Valor de exemplo local abaixo; em produção a senha vem de um passo de operação
# separado (ver docs/RUNBOOK_DEV.md).
APP_DB_PASSWORD=bella_app_dev_password
APP_DATABASE_URL=postgres://bella_app:bella_app_dev_password@localhost:5433/bella_dev
TEST_APP_DATABASE_URL=postgres://bella_app:bella_app_dev_password@localhost:5433/bella_test

# BETTER_AUTH_SECRET / WEB_ORIGIN: em desenvolvimento são opcionais (a API sobe sem
# elas). Em produção (NODE_ENV=production) as três — APP_DATABASE_URL acima,
# BETTER_AUTH_SECRET e WEB_ORIGIN — são OBRIGATÓRIAS: a API recusa subir sem elas
# (apps/api/src/config.ts). Nunca comitar um valor real aqui (regra 9 do CLAUDE.md).
# Gerar um segredo forte: `openssl rand -base64 32` (mín. 16 caracteres).
BETTER_AUTH_SECRET=troque-por-um-segredo-forte-gerado-com-openssl-rand
# URL pública onde a própria API responde em produção (usada pelo Better Auth pra
# montar callbacks/cookies). Em dev local, o default em config.ts já aponta para
# http://localhost:3001 — só precisa ser definida explicitamente em produção.
BETTER_AUTH_URL=http://localhost:3001
# Origem pública do apps/web em produção (usada em CORS/trustedOrigins). Sem valor,
# CORS bloqueia toda origem (fail-closed) — só precisa ser definida em produção.
WEB_ORIGIN=http://localhost:3000
